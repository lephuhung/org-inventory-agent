<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OrgInventoryAgent.Linux</RootNamespace>
    <AssemblyName>OrgInventoryAgent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <!-- Metadata đầy đủ để đảm bảo tính minh bạch và chống AV false positive.
         Trên Linux cũng giữ nguyên để bảo đảm fingerprint binary nhất quán với
         bản Windows khi server so sánh User-Agent / cert subject. -->
    <Company>Phòng An ninh mạng và phòng, chống tội phạm sử dụng công nghệ cao, Công an tỉnh Hà Tĩnh</Company>
    <Authors>Phòng ANM &amp; PCTP sử dụng CNC, Công an tỉnh Hà Tĩnh</Authors>
    <Product>OrgInventory Agent - Hệ thống Quản lý Tài sản CNTT &amp; ATTT</Product>
    <AssemblyTitle>OrgInventory Agent (Linux)</AssemblyTitle>
    <Description>Hệ thống Quản lý Tài sản Công nghệ Thông tin &amp; Đánh giá An toàn Thông tin - Phiên bản Linux (Debian/Ubuntu, RHEL/CentOS, Arch) - Phát triển bởi Phòng An ninh mạng và phòng, chống tội phạm sử dụng công nghệ cao, Công an tỉnh Hà Tĩnh. Thu thập thông số phần cứng, phần mềm, kiểm tra an toàn hệ thống ở chế độ chỉ đọc (Read-only), bảo mật mTLS, zero-GUI.</Description>
    <Copyright>Bản quyền (c) 2025-2026 Phòng An ninh mạng và PCTP sử dụng công nghệ cao, Công an tỉnh Hà Tĩnh</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>..\..\Assets\agent.ico</ApplicationIcon>

    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\OrgInventoryAgent.Core\OrgInventoryAgent.Core.csproj" />
  </ItemGroup>

  <!-- Publish profile cho Linux self-contained single-file.
       Cấu hình chống Antivirus / Defender False Positive (tương thích cơ chế Windows):
       - TẮT nén (EnableCompressionInSingleFile=false): tránh bị nhận nhầm là packer/crypter.
       - TẮT tự giải nén ra $TMPDIR (IncludeNativeLibrariesForSelfExtract=false).
       - DebugType=none: làm sạch ELF section. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-musl-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>