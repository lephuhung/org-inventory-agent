<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OrgInventoryAgent</RootNamespace>
    <AssemblyName>OrgInventoryAgent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <!-- Metadata đầy đủ để đảm bảo tính minh bạch và chống AV false positive -->
    <Company>Phòng An ninh mạng và phòng, chống tội phạm sử dụng công nghệ cao, Công an tỉnh Hà Tĩnh</Company>
    <Authors>Phòng ANM &amp; PCTP sử dụng CNC, Công an tỉnh Hà Tĩnh</Authors>
    <Product>OrgInventory Agent - Hệ thống Quản lý Tài sản CNTT &amp; ATTT</Product>
    <AssemblyTitle>OrgInventory Agent</AssemblyTitle>
    <Description>Hệ thống Quản lý Tài sản CNTT &amp; Đánh giá An toàn Thông tin - Phát triển bởi Phòng An ninh mạng và phòng, chống tội phạm sử dụng công nghệ cao, Công an tỉnh Hà Tĩnh. Thu thập thông số phần cứng, phần mềm, kiểm tra an toàn hệ thống ở chế độ chỉ đọc (Read-only), bảo mật mTLS, zero-GUI.</Description>
    <Copyright>Bản quyền (c) 2025-2026 Phòng An ninh mạng và PCTP sử dụng công nghệ cao, Công an tỉnh Hà Tĩnh</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>..\..\Assets\agent.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- KHÔNG dùng net8.0-windows: phải build được trên Linux (CI/dev). API Windows-only
         đều được bọc RuntimeInformation.IsOSPlatform(Windows) trong code. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrgInventoryAgent.Core\OrgInventoryAgent.Core.csproj" />
  </ItemGroup>

  <!-- Publish profile cho Windows self-contained single-file (chạy trên Windows khi đóng MSI).
       Hỗ trợ cả 64-bit (win-x64) và 32-bit (win-x86) cho các máy Windows cũ.
       Cấu hình chống Antivirus / Defender False Positive (!ml):
       - TẮT nén (EnableCompressionInSingleFile=false): tránh bị nhận nhầm là packer/crypter độc hại.
       - TẮT tự giải nén ra %TEMP% (IncludeNativeLibrariesForSelfExtract=false): tránh bị coi là dropper.
       - DebugType=none: làm sạch PE section header. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
