<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OrgInventoryAgent</RootNamespace>
    <AssemblyName>OrgInventoryAgent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <!-- Metadata đầy đủ để chống AV false positive (mục 3.2 kế hoạch) -->
    <Company>OrgInventory</Company>
    <Product>OrgInventory Agent</Product>
    <AssemblyTitle>OrgInventory Agent</AssemblyTitle>
    <Description>IT Asset Inventory agent: thu thập cấu hình máy, fingerprint đa nguồn, mTLS. Chỉ đọc WMI/Registry, zero-GUI.</Description>
    <Copyright>Copyright (c) 2025 OrgInventory</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>..\..\Assets\agent.ico</ApplicationIcon>

    <!-- KHÔNG dùng net8.0-windows: phải build được trên Linux (CI/dev). API Windows-only
         đều được bọc RuntimeInformation.IsOSPlatform(Windows) trong code. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Publish profile cho Windows self-contained single-file (chạy trên Windows khi đóng MSI).
       Không ảnh hưởng `dotnet build` trên Linux. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
